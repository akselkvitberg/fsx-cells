<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `fsi` object scripts use (fsi.AddPrinter, fsi.PrintLength, fsi.CommandLineArgs, ...), built from our own
       source with the assembly name F# Interactive looks for. The .NET SDK ships this assembly too, but precompiled
       (ReadyToRun) for the SDK's own platform, so a copy taken from a Linux build machine doesn't load on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FSharp.Compiler.Interactive.Settings</AssemblyName>
    <RootNamespace>FSharp.Compiler.Interactive</RootNamespace>
    <Version>15.2.403</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Settings.fs" />
  </ItemGroup>

</Project>
