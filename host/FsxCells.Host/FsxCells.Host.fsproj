<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Run on the newest installed .NET, so the F# compiler of a newer SDK can load. -->
    <RollForward>LatestMajor</RollForward>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- The compiler's translations come from the SDK too. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sdk.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Formatting.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Compiled against the oldest .NET 10 releases, but not shipped: at run time they are loaded from the installed
       .NET SDK (see Sdk.fs), which can be any newer version. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.0.100" ExcludeAssets="runtime" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.10.100" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
